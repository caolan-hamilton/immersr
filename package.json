{
  "name": "crosstalki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:web": "pnpm --filter @crosstalki/web build",
    "db:local": "docker run --rm -d --name crosstalki-dynamodb -p 8000:8000 amazon/dynamodb-local:latest -jar DynamoDBLocal.jar -inMemory -sharedDb",
    "db:local:stop": "docker stop crosstalki-dynamodb",
    "synth": "pnpm build:web && pnpm --filter @crosstalki/infra cdk synth",
    "deploy:dev": "pnpm build:web && pnpm --filter @crosstalki/infra cdk deploy Crosstalki-dev-$USER",
    "dev:web": "pnpm --filter @crosstalki/web dev"
  }
}
